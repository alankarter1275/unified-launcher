export struct AppItem {
    app_id: string,
    text: string,
    has_native_icon: bool,
    native_icon: image,
    text_icon: string,
}

export struct PinItem {
    app_id: string,
    text: string,
    shortcut: string,
    has_native_icon: bool,
    native_icon: image,
    text_icon: string,
}

export struct FolderItem {
    id: string,
    label: string,
    path: string,
}

export struct NoteItem {
    id: string,
    title: string,
}

export struct VaultItem {
    id: string,
    name: string,
    secret: string,
    note: string,
}

export struct CalendarDay {
    label: string,
    in_current_month: bool,
    is_today: bool,
}

// --------------------------------------------------------
// CUSTOM COMPONENTS
// --------------------------------------------------------
component SidebarButton inherits Rectangle {
    in property <string> icon;
    in property <color> icon_color: #abb2bf;
    in property <bool> is_active: false;
    callback clicked;

    width: 54px;
    height: 54px;
    background: transparent;

    private property <string> icon_font: "JetBrainsMono Nerd Font Propo";

    bg := Rectangle {
        width: ta.pressed ? 36px : 46px;
        height: ta.pressed ? 36px : 46px;
        border-radius: self.width / 2;
        x: (parent.width - self.width) / 2;
        y: (parent.height - self.height) / 2;

        states [
            active when root.is_active: {
                background: #2c323c;
                in { animate background { duration: 150ms; } }
            }
            hover when ta.has-hover && !root.is_active: {
                background: #252931;
                in { animate background { duration: 100ms; } }
                out { animate background { duration: 150ms; } }
            }
        ]

        animate width, height {
            duration: 250ms;
            easing: cubic-bezier(0.34, 1.56, 0.64, 1);
        }

        Text {
            text: root.icon;
            color: root.icon_color;
            font-family: root.icon_font;
            font-size: ta.pressed ? 18px : 24px;
            font-weight: root.is_active ? 700 : 400;
            horizontal-alignment: center;
            vertical-alignment: center;
            width: 100%;
            height: 100%;
            animate font-size {
                duration: 250ms;
                easing: cubic-bezier(0.34, 1.56, 0.64, 1);
            }
        }
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

// --------------------------------------------------------
// POWER GRID BUTTON
// --------------------------------------------------------
component PowerButton inherits Rectangle {
    in property <string> icon;
    in property <string> label;
    in property <color> bg: #3e4451;
    in property <color> icon_color: #abb2bf;
    in property <bool> is_focused: false;
    callback clicked;

    background: root.is_focused ? #2c323c : transparent;
    border-radius: 24px;

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }

    Rectangle {
        width: 100%;
        height: 100%;
        border-radius: 24px;
        background: root.bg;

        VerticalLayout {
            alignment: center;
            spacing: 12px;

            Text {
                text: root.icon;
                color: root.icon_color;
                font-family: "JetBrainsMono Nerd Font Propo";
                font-size: 40px;
                horizontal-alignment: center;
            }
            Text {
                text: root.label;
                color: root.is_focused ? #ffffff : #abb2bf;
                font-size: 14px;
                font-weight: 600;
                horizontal-alignment: center;
            }
        }
    }
}

// --------------------------------------------------------
// PINNED APPLICATION BUTTON
// --------------------------------------------------------
component PinButton inherits Rectangle {
    in property <string> app_id;
    in property <bool> has_native_icon: false;
    in property <image> native_icon;
    in property <string> text_icon: "+";
    callback clicked(string);

    private property <bool> is_empty: root.app_id == "";
    private property <string> icon_font: "JetBrainsMono Nerd Font Propo";

    width: 56px;
    height: 56px;
    border-radius: 14px;
    border-width: 1px;
    border-color: root.is_empty ? #30343c : #3e4451;
    background: root.is_empty ? #1d2025 : #252931;

    states [
        hover when ta.has-hover: {
            background: root.is_empty ? #252931 : #2c323c;
            border-color: #61afef;
            in {
                animate background { duration: 120ms; }
                animate border-color { duration: 120ms; }
            }
            out {
                animate background { duration: 150ms; }
                animate border-color { duration: 150ms; }
            }
        }
    ]

    if root.has_native_icon: Image {
        source: root.native_icon;
        width: 100%;
        height: 100%;
        image-fit: contain;
    }
    if !root.has_native_icon: Text {
        text: root.text_icon;
        color: root.is_empty ? #5c6370 : #61afef;
        font-family: root.icon_font;
        font-size: root.is_empty ? 30px : 32px;
        width: 100%;
        height: 100%;
        horizontal-alignment: center;
        vertical-alignment: center;
    }

    ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => {
            if (!root.is_empty) {
                root.clicked(root.app_id);
            }
        }
    }
}

