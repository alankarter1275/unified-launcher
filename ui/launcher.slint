        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.clicked(); }
    }
}

component FolderRow inherits Rectangle {
    in property <string> folder_id;
    in property <string> label;
    in property <string> path;
    callback opened(string);
    callback removed(string);

    height: 48px;
    border-radius: 12px;
    border-width: 1px;
    border-color: #3e4451;
    background: row_ta.has-hover ? #2c323c : #252931;

    row_ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.opened(root.folder_id); }
    }

    HorizontalLayout {
        padding-left: 14px;
        padding-right: 10px;
        spacing: 10px;
        Text {
            text: "󰉋";
            color: #98c379;
            font-family: "JetBrainsMono Nerd Font Propo";
            font-size: 20px;
            width: 24px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        VerticalLayout {
            alignment: center;
            spacing: 1px;
            Text {
                text: root.label;
                color: #ffffff;
                font-size: 13px;
                font-weight: 700;
                overflow: elide;
            }
            Text {
                text: root.path;
                color: #5c6370;
                font-size: 10px;
                overflow: elide;
            }
        }
        Rectangle { horizontal-stretch: 1; }
        delete_button := Rectangle {
            width: 26px;
            height: 26px;
            border-radius: 13px;
            background: delete_ta.has-hover ? #4b2a2e : transparent;
            Text {
                text: "✕";
                color: #e06c75;
                font-size: 12px;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            delete_ta := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.removed(root.folder_id); }
            }
        }
    }

}

component NoteRow inherits Rectangle {
    in property <string> note_id;
    in property <string> title;
    in property <bool> selected: false;
    callback selected_note(string);
    callback removed(string);

    height: 38px;
    border-radius: 9px;
    background: root.selected ? #2c323c : row_ta.has-hover ? #252931 : transparent;

    row_ta := TouchArea {
        width: 100%;
        height: 100%;
        mouse-cursor: pointer;
        clicked => { root.selected_note(root.note_id); }
    }

    HorizontalLayout {
        padding-left: 10px;
        padding-right: 5px;
        spacing: 7px;
        Text {
            text: "󰎚";
            color: root.selected ? #c678dd : #5c6370;
            font-family: "JetBrainsMono Nerd Font Propo";
            font-size: 15px;
            width: 18px;
            vertical-alignment: center;
            horizontal-alignment: center;
        }
        Text {
            text: root.title;
            color: root.selected ? #ffffff : #abb2bf;
            font-size: 12px;
            font-weight: 600;
            horizontal-stretch: 1;
            vertical-alignment: center;
            overflow: elide;
        }
        Rectangle {
            width: 22px;
            height: 22px;
            border-radius: 11px;
            background: remove_ta.has-hover ? #4b2a2e : transparent;
            Text {
                text: "✕";
                color: #e06c75;
                font-size: 10px;
                width: 100%;
                height: 100%;
                horizontal-alignment: center;
                vertical-alignment: center;
            }
            remove_ta := TouchArea {
                width: 100%;
                height: 100%;
                mouse-cursor: pointer;
                clicked => { root.removed(root.note_id); }
            }
        }
    }
}

component UtilityPlaceholder inherits Rectangle {
    in property <string> icon;
    in property <string> title;
    in property <string> description;

    background: transparent;

    VerticalLayout {
        alignment: center;
        spacing: 12px;

        Text {
            text: root.icon;
            color: #61afef;
            font-family: "JetBrainsMono Nerd Font Propo";
            font-size: 52px;
            horizontal-alignment: center;
        }
        Text {
            text: root.title;
            color: #ffffff;
            font-size: 22px;
            font-weight: 700;
            horizontal-alignment: center;
        }
        Text {
            text: root.description;
            color: #abb2bf;
            font-size: 14px;
            horizontal-alignment: center;
            wrap: word-wrap;
        }
        Text {
            text: "Esc to return to apps";
            color: #5c6370;
            font-size: 12px;
            horizontal-alignment: center;
        }
    }
}

// --------------------------------------------------------
// MAIN WINDOW
// --------------------------------------------------------
export component LauncherWindow inherits Window {
    width: 640px;
    height: 440px;
    background: transparent;
    no-frame: true;
    always-on-top: true;

    in-out property <string> current_view: "main";
    in-out property <string> search_text <=> search_input.text;
    in property <[AppItem]> display_items: [];
    in property <[PinItem]> pinned_items: [];
    in property <[FolderItem]> folder_items: [];
    in-out property <[string]> folder_suggestions: [];
    in-out property <bool> folder_form_visible: false;
    in-out property <string> folder_name: "";
    in-out property <string> folder_path: "";

    // Notes state
    in property <[NoteItem]> note_items: [];
    in-out property <string> selected_note_id: "";
    in-out property <string> note_title: "";
    in-out property <string> note_content: "";
    in-out property <bool> note_dirty: false;

    // Vault state
    in-out property <bool> vault_locked: true;
    in property <[VaultItem]> vault_items: [];
    in-out property <string> vault_password: "";
    in-out property <string> vault_new_name: "";
    in-out property <string> vault_new_secret: "";
    in-out property <string> vault_new_note: "";
    in-out property <bool> vault_form_visible: false;

    // Clock and calendar state
    in property <[CalendarDay]> calendar_days: [];
    in-out property <string> calendar_month: "";
    in-out property <string> clock_text: "";
    in-out property <string> clock_date: "";

    in-out property <int> absolute_index: 0;
    in property <string> ribbon_text: "Apps";
    in-out property <string> toast_message: "";

    // Calculator mode
    in property <bool> calc_mode: false;
    in property <string> calc_expression: "";
    in property <string> calc_result: "";
    in property <bool> calc_error: false;
    in property <string> calc_raw_result: "";

    // Power view keyboard navigation
    in-out property <int> power_index: 0;

    property <length> item_height: 44px;
    property <string> icon_font: "JetBrainsMono Nerd Font Propo";

    callback text_changed(string);
    callback clear_search();
    callback execute_selected(string, bool);
    callback pin_app_requested(string, int);
    callback launch_pinned_app(int);
    callback item_highlighted(int, int, string);
    callback add_folder(string, string);
    callback delete_folder(string);
    callback open_folder(string);
    callback folder_path_changed(string);
    callback folder_suggestion_selected(string);
    callback create_note();
    callback load_note(string);
    callback save_note(string, string, string);
    callback delete_note(string);
    callback vault_unlock(string);
    callback vault_lock();
    callback vault_add(string, string, string);
    callback vault_delete(string);
    callback calendar_previous_month();
    callback calendar_next_month();
    callback calendar_today();
    callback open_file(string);
    callback open_file_in_yazi(string);
    callback power_action(string);
    callback close_requested();

    public function focus_search() { search_input.focus(); }

    public function show_main() {
        root.current_view = "main";
        root.focus_search();
    }

    public function show_folder_form() {
        root.folder_name = "";
        root.folder_path = "";
        root.folder_suggestions = [];
        root.folder_form_visible = true;
    }

    public function cancel_folder_form() {
        root.folder_form_visible = false;
        root.folder_name = "";
        root.folder_path = "";
        root.folder_suggestions = [];
    }

    public function mark_note_dirty() {
        if (root.selected_note_id != "") {
            root.note_dirty = true;
        }
    }

    public function select_note(id: string) {
        if (id == root.selected_note_id) { return; }
        if (root.note_dirty && root.selected_note_id != "") {
            root.note_dirty = false;
            root.save_note(root.selected_note_id, root.note_title, root.note_content);
        }
        root.load_note(id);
    }

    public function create_new_note() {
        if (root.note_dirty && root.selected_note_id != "") {
            root.note_dirty = false;
            root.save_note(root.selected_note_id, root.note_title, root.note_content);
        }
        root.create_note();
    }

    public function pin_current_app(slot: int) {
        if (root.display_items.length > 0) {
            root.pin_app_requested(root.display_items[root.absolute_index].app_id, slot);
        }
    }

    pure function shortcut_for_app(app_id: string) -> string {
        if (root.pinned_items.length > 0 && root.pinned_items[0].app_id == app_id) { return root.pinned_items[0].shortcut; }
        if (root.pinned_items.length > 1 && root.pinned_items[1].app_id == app_id) { return root.pinned_items[1].shortcut; }
        if (root.pinned_items.length > 2 && root.pinned_items[2].app_id == app_id) { return root.pinned_items[2].shortcut; }
        if (root.pinned_items.length > 3 && root.pinned_items[3].app_id == app_id) { return root.pinned_items[3].shortcut; }
        if (root.pinned_items.length > 4 && root.pinned_items[4].app_id == app_id) { return root.pinned_items[4].shortcut; }
        if (root.pinned_items.length > 5 && root.pinned_items[5].app_id == app_id) { return root.pinned_items[5].shortcut; }
        return "";
    }

    public function adjust_scroll() {
        if (root.display_items.length == 0) { return; }
        if (root.absolute_index == 0) {
            list_flickable.viewport-y = 0;
        } else {
            let item_top = root.absolute_index * root.item_height;
            let item_bottom = item_top + root.item_height;
            let view_top = -list_flickable.viewport-y;
            let view_bottom = view_top + list_flickable.height;

            if (item_top < view_top) {
                list_flickable.viewport-y = -item_top;
            } else if (item_bottom > view_bottom) {
                list_flickable.viewport-y = -(item_bottom - list_flickable.height);
            }
        }
        root.item_highlighted(
            root.absolute_index,
            root.display_items.length,
            root.display_items[root.absolute_index].text,
        );
    }

    init => { root.focus_search(); }

    FocusScope {
        key-pressed(event) => {
            // ---- POWER VIEW KEYS ----
            if (root.current_view == "power") {
                if (event.text == Key.Escape) {
                    root.show_main();
                    return accept;
                }
                if (event.text == Key.LeftArrow) {
                    if (root.power_index > 0) { root.power_index -= 1; }
                    return accept;
                }
                if (event.text == Key.RightArrow) {
                    if (root.power_index < 3) { root.power_index += 1; }
                    return accept;
                }
                if (event.text == Key.UpArrow) {
                    if (root.power_index >= 2) { root.power_index -= 2; }
                    return accept;
                }
                if (event.text == Key.DownArrow) {
                    if (root.power_index <= 1) { root.power_index += 2; }
                    return accept;
                }
                if (event.text == Key.Return) {
                    if (root.power_index == 0) { root.power_action("lock"); }
                    else if (root.power_index == 1) { root.power_action("shutdown"); }
                    else if (root.power_index == 2) { root.power_action("logout"); }
                    else if (root.power_index == 3) { root.power_action("reboot"); }
                    return accept;
                }
                return reject;
            }

            // ---- FUTURE INLINE VIEWS ----
            if (root.current_view != "main") {
                if (event.text == Key.Escape) {
                    root.show_main();
                    return accept;
                }
                return reject;
            }

            // ---- CALCULATOR MODE KEYS ----
            if (root.calc_mode) {
                if (event.text == Key.Escape) {
                    root.close_requested();
                    return accept;
                }
                if (event.text == Key.Return) {
                    if (root.calc_result != "") {
                        root.execute_selected(root.calc_result, false);
                    }
                    return accept;
                }
                return reject;
            }

            // ---- PIN SHORTCUTS ----
            if (event.modifiers.control && event.modifiers.alt) {
                if (event.text == "1") { root.pin_current_app(0); return accept; }
                if (event.text == "2") { root.pin_current_app(1); return accept; }
                if (event.text == "3") { root.pin_current_app(2); return accept; }
                if (event.text == "4") { root.pin_current_app(3); return accept; }
                if (event.text == "5") { root.pin_current_app(4); return accept; }
                if (event.text == "6") { root.pin_current_app(5); return accept; }
            }
            if (event.modifiers.alt) {
                if (event.text == "1") { root.launch_pinned_app(0); return accept; }
                if (event.text == "2") { root.launch_pinned_app(1); return accept; }
                if (event.text == "3") { root.launch_pinned_app(2); return accept; }
                if (event.text == "4") { root.launch_pinned_app(3); return accept; }
                if (event.text == "5") { root.launch_pinned_app(4); return accept; }
                if (event.text == "6") { root.launch_pinned_app(5); return accept; }
            }

            // ---- MAIN VIEW KEYS ----
            if (event.text == Key.Escape) {
                root.close_requested();
                return accept;
            }
            if (event.text == Key.Return) {
                if (root.display_items.length > 0) {
                    root.execute_selected(
                        root.display_items[root.absolute_index].app_id,
                        event.modifiers.shift,
                    );
                }
                return accept;
            }
            if (event.text == Key.UpArrow) {
                if (root.absolute_index > 0) {
                    root.absolute_index -= 1;
                    root.adjust_scroll();
                }
                return accept;
            }
            if (event.text == Key.DownArrow) {
                if (root.absolute_index < root.display_items.length - 1) {
                    root.absolute_index += 1;
                    root.adjust_scroll();
                }
                return accept;
            }
            return reject;
        }

        Rectangle {
            border-radius: 16px;
            border-width: 1px;
            border-color: #3e4451;
            background: #181a1f;

            HorizontalLayout {
                padding-left: 12px;
                padding-right: 1px;
                padding-top: 1px;
                padding-bottom: 1px;
                spacing: 16px;

                // --- Sidebar ---
                VerticalLayout {
                    width: 54px;
                    alignment: center;
                    padding-top: 12px;
                    padding-bottom: 12px;

                    VerticalLayout {
                        spacing: 12px;

                        SidebarButton {
                            icon: "󰃭";
                            icon_color: #e5c07b;
                            is_active: root.current_view == "calendar";
                            clicked => {
                                if (root.current_view == "calendar") {
                                    root.show_main();
                                } else {
                                    root.current_view = "calendar";
                                }
                            }
                        }
                        SidebarButton {
                            icon: "󰎚";
                            icon_color: #c678dd;
                            is_active: root.current_view == "notes";
                            clicked => {
                                if (root.current_view == "notes") {
                                    root.show_main();
                                } else {
                                    root.current_view = "notes";
                                }
                            }
                        }
                        SidebarButton {
                            icon: "󰌋";
                            icon_color: #e5c07b;
                            is_active: root.current_view == "vault";
                            clicked => {
                                if (root.current_view == "vault") {
                                    root.show_main();
                                } else {
                                    root.current_view = "vault";
                                    root.vault_password = "";
                                }
                            }
                        }
                        SidebarButton {
                            icon: "󰉋";
                            icon_color: #98c379;
                            is_active: root.current_view == "folders";
                            clicked => {
                                if (root.current_view == "folders") {
                                    root.show_main();
                                } else {
                                    root.current_view = "folders";
                                }
                            }
                        }
                        SidebarButton {
                            icon: "⏻";
                            icon_color: #e06c75;
                            is_active: root.current_view == "power";
                            clicked => {
                                root.current_view = root.current_view == "power" ? "main" : "power";
                            }
                        }
                    }
                }

                // --- Main content area ---
                Rectangle {
                    horizontal-stretch: 1;
                    background: #21252b;
                    border-radius: 15px;
                    clip: true;

                    // ====== MAIN VIEW ======
                    VerticalLayout {
                        visible: root.current_view == "main";
                        padding: 12px;
                        spacing: 8px;

                        // --- Search bar ---
                        HorizontalLayout {
                            height: 40px;
                            spacing: 12px;

                            Text {
                                text: "";
                                color: #61afef;
                                font-family: root.icon_font;
                                font-size: 18px;
                                vertical-alignment: center;
                            }

                            Rectangle {
                                horizontal-stretch: 1;

                                Text {
                                    width: 100%;
                                    height: 100%;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                    font-size: 18px;
                                    color: #5c6370;
                                    text: search_input.text == "" ? "Search apps..." : "";
                                }

                                search_input := TextInput {
                                    width: 100%;
                                    height: 100%;
                                    vertical-alignment: center;
                                    horizontal-alignment: left;
                                    font-size: 18px;
                                    color: #abb2bf;
                                    single-line: true;
                                    edited => { root.text_changed(self.text); }
                                    key-pressed(event) => {
                                        if (event.modifiers.control && event.modifiers.alt) {
                                            if (event.text == "1") { root.pin_current_app(0); return accept; }
                                            if (event.text == "2") { root.pin_current_app(1); return accept; }
                                            if (event.text == "3") { root.pin_current_app(2); return accept; }
                                            if (event.text == "4") { root.pin_current_app(3); return accept; }
                                            if (event.text == "5") { root.pin_current_app(4); return accept; }
                                            if (event.text == "6") { root.pin_current_app(5); return accept; }
                                        }
                                        if (event.modifiers.alt) {
                                            if (event.text == "1") { root.launch_pinned_app(0); return accept; }
                                            if (event.text == "2") { root.launch_pinned_app(1); return accept; }
                                            if (event.text == "3") { root.launch_pinned_app(2); return accept; }
                                            if (event.text == "4") { root.launch_pinned_app(3); return accept; }
                                            if (event.text == "5") { root.launch_pinned_app(4); return accept; }
                                            if (event.text == "6") { root.launch_pinned_app(5); return accept; }
                                        }
                                        if (event.text == Key.DownArrow) {
                                            if (root.absolute_index < root.display_items.length - 1) {
                                                root.absolute_index += 1;
                                                root.adjust_scroll();
                                            }
                                            return accept;
                                        }
                                        if (event.text == Key.UpArrow) {
                                            if (root.absolute_index > 0) {
                                                root.absolute_index -= 1;
                                                root.adjust_scroll();
                                            }
                                            return accept;
                                        }
                                        if (event.text == Key.Return) {
                                            if (root.display_items.length > 0) {
                                                root.execute_selected(
                                                    root.display_items[root.absolute_index].app_id,
                                                    event.modifiers.shift,
                                                );
                                            }
                                            return accept;
                                        }
                                        if (event.text == Key.Escape) {
                                            root.close_requested();
                                            return accept;
                                        }
                                        return reject;
                                    }
                                }
                            }

                            Rectangle {
                                visible: search_input.text != "";
                                width: 26px;

                                VerticalLayout {
                                    alignment: center;
                                    Rectangle {
                                        width: 26px;
                                        height: 26px;
                                        border-radius: 13px;
                                        background: ta_clear.has-hover ? #3e4451 : transparent;
                                        ta_clear := TouchArea {
                                            width: 100%;
                                            height: 100%;
                                            mouse-cursor: pointer;
                                            clicked => { root.clear_search(); }
                                        }
                                        Text {
                                            text: "✕";
                                            color: #5c6370;
                                            font-size: 13px;
                                            width: 100%;
                                            height: 100%;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                border-radius: root.calc_mode ? 12px : 0px;
                                background: root.calc_mode ? #2c323c : transparent;
                                VerticalLayout {
                                    alignment: center;
                                    padding-left: root.calc_mode ? 10px : 0px;
                                    padding-right: root.calc_mode ? 10px : 0px;
                                    Text {
                                        text: root.calc_mode ? "CALC" : root.ribbon_text;
                                        color: root.calc_mode ? #abb2bf : #5c6370;
                                        font-size: 13px;
                                        font-weight: 600;
                                        vertical-alignment: center;
                                    }
                                }
                            }
                        }

                        // --- Pinned apps: one horizontal icon row ---
                        pinned_area := Rectangle {
                            visible: root.search_text == "" && !root.calc_mode;
                            height: root.search_text == "" && !root.calc_mode ? 64px : 0px;
                            width: 100%;
                            clip: true;

                            for pin[index] in root.pinned_items: PinButton {
                                x: index * (parent.width / 6) + (parent.width / 6 - self.width) / 2;
                                y: (parent.height - self.height) / 2;
                                app_id: pin.app_id;
                                has_native_icon: pin.has_native_icon;
                                native_icon: pin.native_icon;
                                text_icon: pin.text_icon;
                                clicked(app_id) => { root.execute_selected(app_id, false); }
                            }
                        }

                        // --- Content area: App list or Calculator ---
                        Rectangle {
                            vertical-stretch: 1;
                            clip: true;

                            // ===== APP LIST =====
                            Rectangle {
                                visible: !root.calc_mode;
                                width: 100%;
                                height: 100%;

                                list_container := Rectangle {
                                    width: 100%;
                                    height: 100%;
                                    clip: true;
                                    border-radius: 12px;
                                    background: transparent;

                                    list_flickable := Flickable {
                                        width: 100%;
                                        height: 100%;
                                        interactive: true;
                                        viewport-height: inner_layout.preferred-height;

                                        inner_layout := VerticalLayout {
                                            width: list_container.width;
                                            alignment: start;

                                            for item[index] in root.display_items: Rectangle {
                                                height: root.item_height;
                                                width: list_container.width;
                                                property <string> app_shortcut: root.shortcut_for_app(item.app_id);

                                                pill := Rectangle {
                                                    width: item_ta.pressed ? parent.width - 8px : parent.width - 4px;
                                                    height: item_ta.pressed ? 36px : 40px;
                                                    border-radius: 20px;
                                                    background: transparent;
                                                    animate width { duration: 100ms; easing: ease-out; }
                                                    animate height { duration: 100ms; easing: ease-out; }

                                                    indicator := Rectangle {
                                                        x: 4px;
                                                        y: (parent.height - 16px) / 2;
                                                        width: 4px;
                                                        height: 16px;
                                                        border-radius: 2px;
                                                        background: transparent;
                                                    }

                                                    states [
                                                        active when index == root.absolute_index: {
                                                            background: #2c323c;
                                                            indicator.x: 12px;
                                                            indicator.background: #61afef;
                                                            in {
                                                                animate background { duration: 150ms; }
                                                                animate indicator.x { duration: 250ms; easing: ease-out-bounce; }
                                                                animate indicator.background { duration: 150ms; }
                                                            }
                                                            out {
                                                                animate background { duration: 0ms; }
                                                                animate indicator.x { duration: 0ms; }
                                                                animate indicator.background { duration: 0ms; }
                                                            }
                                                        }
                                                        hover when item_ta.has-hover && index != root.absolute_index: {
                                                            background: #252931;
                                                            in { animate background { duration: 100ms; } }
                                                            out { animate background { duration: 150ms; } }
                                                        }
                                                    ]

                                                    HorizontalLayout {
                                                        padding-left: 28px;
                                                        padding-right: 12px;
                                                        spacing: 16px;
                                                        Rectangle {
                                                            width: 24px;
                                                            height: parent.height;
                                                            if item.has_native_icon: Image {
                                                                source: item.native_icon;
                                                                width: 24px;
                                                                height: 24px;
                                                                image-fit: contain;
                                                            }
                                                            if !item.has_native_icon: Text {
                                                                text: item.text_icon;
                                                                font-family: root.icon_font;
                                                                color: index == root.absolute_index ? #61afef : #abb2bf;
                                                                font-size: 20px;
                                                                width: 100%;
                                                                height: 100%;
                                                                horizontal-alignment: center;
                                                                vertical-alignment: center;
                                                            }
                                                        }
                                                        Text {
                                                            text: item.text;
                                                            color: index == root.absolute_index ? #ffffff : #abb2bf;
                                                            font-size: 15px;
                                                            font-weight: 600;
                                                            height: parent.height;
                                                            horizontal-stretch: 1;
                                                            vertical-alignment: center;
                                                            overflow: elide;
                                                        }
                                                        // The layout cell fills the row; the inner pill is
                                                        // explicitly centered within it.
                                                        Rectangle {
                                                            visible: app_shortcut != "";
                                                            width: app_shortcut == "" ? 0px : 48px;
                                                            height: parent.height;

                                                            Rectangle {
                                                                width: 100%;
                                                                height: 24px;
                                                                y: (parent.height - self.height) / 2;
                                                                border-radius: 12px;
                                                                background: index == root.absolute_index ? #3e4451 : #30343c;
                                                                Text {
                                                                    text: app_shortcut;
                                                                    color: #abb2bf;
                                                                    font-size: 10px;
                                                                    font-weight: 700;
                                                                    width: 100%;
                                                                    height: 100%;
                                                                    horizontal-alignment: center;
                                                                    vertical-alignment: center;
                                                                }
                                                            }
                                                        }
                                                    }
                                                }

                                                item_ta := TouchArea {
                                                    width: 100%;
                                                    height: 100%;
                                                    mouse-cursor: pointer;
                                                    changed has-hover => {
                                                        if (self.has-hover) {
                                                            root.absolute_index = index;
                                                            root.adjust_scroll();
                                                        }
                                                    }
                                                    clicked => {
                                                        root.absolute_index = index;
                                                        root.execute_selected(item.app_id, false);
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }

                            // ===== CALCULATOR DISPLAY =====
                            Rectangle {
                                visible: root.calc_mode;
                                width: 100%;
                                height: 100%;

                                VerticalLayout {
                                    width: 100%;
                                    height: 100%;
                                    alignment: center;
                                    spacing: 4px;

                                    Text {
                                        text: root.calc_expression;
                                        color: #5c6370;
                                        font-size: 18px;
                                        horizontal-alignment: center;
                                        vertical-alignment: bottom;
                                    }
                                    Text {
                                        text: root.calc_result == "" ? "..." : root.calc_result;
                                        color: root.calc_error ? #e06c75 : #ffffff;
                                        font-size: 64px;
                                        font-weight: 700;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    Text {
                                        text: root.calc_result == "" ? "" : "Enter to copy  ·  Esc to close";
                                        color: #5c6370;
                                        font-size: 13px;
                                        font-weight: 600;
                                        horizontal-alignment: center;
                                        vertical-alignment: top;
                                    }
                                }
                            }
                        }
                    }

                    // ====== FOLDERS VIEW ======
                    Rectangle {
                        visible: root.current_view == "folders";
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            HorizontalLayout {
                                height: 36px;
                                spacing: 10px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: add_folder_ta.has-hover ? #2c323c : #252931;
                                    Text {
                                        text: "+";
                                        color: #98c379;
                                        font-size: 22px;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    add_folder_ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: pointer;
                                        clicked => { root.show_folder_form(); }
                                    }
                                }
                                Text {
                                    text: root.folder_form_visible ? "Add folder" : "Folders";
                                    color: #ffffff;
                                    font-size: 21px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                Text {
                                    visible: !root.folder_form_visible;
                                    text: root.folder_items.length == 1 ? "1 pinned folder" : root.folder_items.length + " pinned folders";
                                    color: #5c6370;
                                    font-size: 12px;
                                    vertical-alignment: center;
                                }
                            }

                            if root.folder_form_visible: Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Name";
                                        color: #abb2bf;
                                        font-size: 12px;
                                        font-weight: 700;
                                    }
                                    Rectangle {
                                        height: 38px;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: folder_name_input.has-focus ? #61afef : #3e4451;
                                        background: #181a1f;
                                        folder_name_input := TextInput {
                                            text <=> root.folder_name;
                                            width: 100%;
                                            height: 100%;
                                            vertical-alignment: center;
                                            font-size: 14px;
                                            color: #ffffff;
                                            single-line: true;
                                            accepted => { folder_path_input.focus(); }
                                        }
                                        Text {
                                            visible: folder_name_input.text == "";
                                            text: "Projects";
                                            color: #5c6370;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                            x: 12px;
                                        }
                                    }
                                    Text {
                                        text: "Path";
                                        color: #abb2bf;
                                        font-size: 12px;
                                        font-weight: 700;
                                    }
                                    Rectangle {
                                        height: 38px;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: folder_path_input.has-focus ? #61afef : #3e4451;
                                        background: #181a1f;
                                        folder_path_input := TextInput {
                                            text <=> root.folder_path;
                                            width: 100%;
                                            height: 100%;
                                            vertical-alignment: center;
                                            font-size: 14px;
                                            color: #ffffff;
                                            single-line: true;
                                            edited => { root.folder_path_changed(self.text); }
                                            accepted => { root.add_folder(root.folder_name, root.folder_path); }
                                        }
                                        Text {
                                            visible: folder_path_input.text == "";
                                            text: "~/Documents";
                                            color: #5c6370;
                                            font-size: 14px;
                                            vertical-alignment: center;
                                            x: 12px;
                                        }
                                    }

                                    suggestions_area := Rectangle {
                                        visible: root.folder_suggestions.length > 0;
                                        height: root.folder_suggestions.length > 0 ? 88px : 0px;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: #3e4451;
                                        background: #181a1f;
                                        clip: true;
                                        Flickable {
                                            width: 100%;
                                            height: 100%;
                                            viewport-height: suggestion_layout.preferred-height;
                                            suggestion_layout := VerticalLayout {
                                                width: parent.width;
                                                alignment: start;
                                                for suggestion in root.folder_suggestions: Rectangle {
                                                    height: 28px;
                                                    Text {
                                                        text: suggestion;
                                                        color: #abb2bf;
                                                        font-size: 12px;
                                                        x: 10px;
                                                        width: parent.width - 20px;
                                                        height: 100%;
                                                        vertical-alignment: center;
                                                        overflow: elide;
                                                    }
                                                    suggestion_ta := TouchArea {
                                                        width: 100%;
                                                        height: 100%;
                                                        mouse-cursor: pointer;
                                                        clicked => { root.folder_suggestion_selected(suggestion); }
                                                    }
                                                }
                                            }
                                        }
                                    }

                                    Rectangle { vertical-stretch: 1; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        QuickActionButton {
                                            horizontal-stretch: 1;
                                            icon: "✕";
                                            label: "Cancel";
                                            clicked => { root.cancel_folder_form(); }
                                        }
                                        QuickActionButton {
                                            horizontal-stretch: 1;
                                            icon: "+";
                                            label: "Add folder";
                                            clicked => { root.add_folder(root.folder_name, root.folder_path); }
                                        }
                                    }
                                }
                            }

                            if !root.folder_form_visible: Rectangle {
                                vertical-stretch: 1;
                                if root.folder_items.length == 0: Text {
                                    text: "No pinned folders yet\nUse + to add one.";
                                    color: #5c6370;
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                if root.folder_items.length > 0: Flickable {
                                    width: 100%;
                                    height: 100%;
                                    viewport-height: folder_list.preferred-height;
                                    folder_list := VerticalLayout {
                                        width: parent.width;
                                        alignment: start;
                                        spacing: 7px;
                                        for folder in root.folder_items: FolderRow {
                                            folder_id: folder.id;
                                            label: folder.label;
                                            path: folder.path;
                                            opened(id) => { root.open_folder(id); }
                                            removed(id) => { root.delete_folder(id); }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ====== CLOCK & CALENDAR VIEW ======
                    Rectangle {
                        visible: root.current_view == "calendar";
                        width: 100%;
                        height: 100%;

                        VerticalLayout {
                            padding: 16px;
                            spacing: 6px;

                            Text {
                                text: root.clock_text;
                                color: #ffffff;
                                font-size: 48px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: root.clock_date;
                                color: #abb2bf;
                                font-size: 14px;
                                horizontal-alignment: center;
                            }

                            HorizontalLayout {
                                height: 36px;
                                spacing: 8px;
                                ProfileButton {
                                    width: 42px;
                                    label: "‹";
                                    clicked => { root.calendar_previous_month(); }
                                }
                                Text {
                                    text: root.calendar_month;
                                    color: #ffffff;
                                    font-size: 16px;
                                    font-weight: 700;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                                ProfileButton {
                                    width: 62px;
                                    label: "Today";
                                    clicked => { root.calendar_today(); }
                                }
                                ProfileButton {
                                    width: 42px;
                                    label: "›";
                                    clicked => { root.calendar_next_month(); }
                                }
                            }

                            HorizontalLayout {
                                height: 20px;
                                for weekday in ["Mon", "Tue", "Wed", "Thu", "Fri", "Sat", "Sun"]: Text {
                                    text: weekday;
                                    color: #5c6370;
                                    font-size: 10px;
                                    font-weight: 700;
                                    horizontal-stretch: 1;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }
                            }

                            calendar_grid := Rectangle {
                                width: 100%;
                                height: 204px;
                                for day[index] in root.calendar_days: Rectangle {
                                    x: mod(index, 7) * (parent.width / 7);
                                    y: floor(index / 7) * 34px;
                                    width: parent.width / 7;
                                    height: 34px;
                                    Rectangle {
                                        width: 28px;
                                        height: 28px;
                                        x: (parent.width - self.width) / 2;
                                        y: (parent.height - self.height) / 2;
                                        border-radius: 14px;
                                        background: day.is_today ? #61afef : transparent;
                                        Text {
                                            text: day.label;
                                            color: day.is_today ? #181a1f : day.in_current_month ? #ffffff : #5c6370;
                                            font-size: 12px;
                                            font-weight: day.is_today ? 700 : 500;
                                            width: 100%;
                                            height: 100%;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ====== NOTES VIEW ======
                    Rectangle {
                        visible: root.current_view == "notes";
                        width: 100%;
                        height: 100%;

                        HorizontalLayout {
                            spacing: 10px;

                            Rectangle {
                                width: 180px;
                                background: #181a1f;
                                border-radius: 12px;
                                VerticalLayout {
                                    padding: 10px;
                                    spacing: 8px;
                                    HorizontalLayout {
                                        height: 28px;
                                        Text {
                                            text: "Notes";
                                            color: #ffffff;
                                            font-size: 16px;
                                            font-weight: 700;
                                            vertical-alignment: center;
                                        }
                                        Rectangle { horizontal-stretch: 1; }
                                        Rectangle {
                                            width: 26px;
                                            height: 26px;
                                            border-radius: 13px;
                                            background: new_note_ta.has-hover ? #2c323c : #252931;
                                            Text {
                                                text: "+";
                                                color: #c678dd;
                                                font-size: 18px;
                                                width: 100%;
                                                height: 100%;
                                                horizontal-alignment: center;
                                                vertical-alignment: center;
                                            }
                                            new_note_ta := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                mouse-cursor: pointer;
                                                clicked => { root.create_new_note(); }
                                            }
                                        }
                                    }

                                    Rectangle {
                                        vertical-stretch: 1;
                                        visible: root.note_items.length == 0;
                                        Text {
                                            text: "No notes yet\nUse + to create one.";
                                            color: #5c6370;
                                            font-size: 12px;
                                            width: 100%;
                                            height: 100%;
                                            horizontal-alignment: center;
                                            vertical-alignment: center;
                                        }
                                    }
                                    Flickable {
                                        vertical-stretch: 1;
                                        visible: root.note_items.length > 0;
                                        viewport-height: note_list.preferred-height;
                                        note_list := VerticalLayout {
                                            width: parent.width;
                                            alignment: start;
                                            spacing: 4px;
                                            for note in root.note_items: NoteRow {
                                                note_id: note.id;
                                                title: note.title;
                                                selected: note.id == root.selected_note_id;
                                                selected_note(id) => { root.select_note(id); }
                                                removed(id) => { root.delete_note(id); }
                                            }
                                        }
                                    }
                                }
                            }

                            Rectangle {
                                horizontal-stretch: 1;
                                background: #21252b;
                                border-radius: 12px;
                                clip: true;

                                if root.selected_note_id == "": Text {
                                    text: "Create or select a note";
                                    color: #5c6370;
                                    font-size: 15px;
                                    width: 100%;
                                    height: 100%;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                }

                                if root.selected_note_id != "": VerticalLayout {
                                    padding: 14px;
                                    spacing: 8px;
                                    Rectangle {
                                        height: 38px;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: note_title_input.has-focus ? #c678dd : #3e4451;
                                        background: #181a1f;
                                        note_title_input := TextInput {
                                            text <=> root.note_title;
                                            width: 100%;
                                            height: 100%;
                                            vertical-alignment: center;
                                            font-size: 17px;
                                            font-weight: 700;
                                            color: #ffffff;
                                            single-line: true;
                                            edited => { root.mark_note_dirty(); }
                                        }
                                    }
                                    Rectangle {
                                        vertical-stretch: 1;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: note_content_input.has-focus ? #c678dd : #3e4451;
                                        background: #181a1f;
                                        note_content_input := TextInput {
                                            text <=> root.note_content;
                                            width: 100%;
                                            height: 100%;
                                            vertical-alignment: top;
                                            font-size: 14px;
                                            color: #abb2bf;
                                            single-line: false;
                                            edited => { root.mark_note_dirty(); }
                                        }
                                        Text {
                                            visible: note_content_input.text == "";
                                            text: "Write something…";
                                            color: #5c6370;
                                            font-size: 14px;
                                            x: 10px;
                                            y: 10px;
                                        }
                                    }
                                    Text {
                                        text: root.note_dirty ? "Autosaving…" : "Saved locally";
                                        color: root.note_dirty ? #c678dd : #5c6370;
                                        font-size: 11px;
                                    }
                                }
                            }
                        }
                    }

                    // ====== VAULT VIEW ======
                    Rectangle {
                        visible: root.current_view == "vault";
                        width: 100%;
                        height: 100%;

                        if root.vault_locked: VerticalLayout {
                            alignment: center;
                            padding: 24px;
                            spacing: 16px;

                            Text {
                                text: "󰌋";
                                color: #e5c07b;
                                font-family: "JetBrainsMono Nerd Font Propo";
                                font-size: 48px;
                                horizontal-alignment: center;
                            }
                            Text {
                                text: "Unlock Vault";
                                color: #ffffff;
                                font-size: 21px;
                                font-weight: 700;
                                horizontal-alignment: center;
                            }
                            Rectangle {
                                height: 40px;
                                width: 280px;
                                border-radius: 9px;
                                border-width: 1px;
                                border-color: vault_password_input.has-focus ? #e5c07b : #3e4451;
                                background: #181a1f;
                                Text {
                                    visible: vault_password_input.text == "";
                                    text: "Master password...";
                                    color: #5c6370;
                                    font-size: 14px;
                                    x: 12px;
                                    height: 100%;
                                    vertical-alignment: center;
                                }
                                vault_password_input := TextInput {
                                    text <=> root.vault_password;
                                    width: 100%;
                                    height: 100%;
                                    vertical-alignment: center;
                                    font-size: 14px;
                                    color: #ffffff;
                                    single-line: true;
                                    input-type: password;
                                    accepted => { root.vault_unlock(self.text); }
                                }
                            }
                        }

                        if !root.vault_locked: VerticalLayout {
                            padding: 16px;
                            spacing: 10px;

                            HorizontalLayout {
                                height: 36px;
                                spacing: 10px;
                                Rectangle {
                                    width: 32px;
                                    height: 32px;
                                    border-radius: 16px;
                                    background: add_vault_ta.has-hover ? #2c323c : #252931;
                                    Text {
                                        text: "+";
                                        color: #e5c07b;
                                        font-size: 22px;
                                        width: 100%;
                                        height: 100%;
                                        horizontal-alignment: center;
                                        vertical-alignment: center;
                                    }
                                    add_vault_ta := TouchArea {
                                        width: 100%;
                                        height: 100%;
                                        mouse-cursor: pointer;
                                        clicked => {
                                            root.vault_form_visible = true;
                                            root.vault_new_name = "";
                                            root.vault_new_secret = "";
                                            root.vault_new_note = "";
                                        }
                                    }
                                }
                                Text {
                                    text: root.vault_form_visible ? "Add Secret" : "Vault";
                                    color: #ffffff;
                                    font-size: 21px;
                                    font-weight: 700;
                                    vertical-alignment: center;
                                }
                                Rectangle { horizontal-stretch: 1; }
                                QuickActionButton {
                                    icon: "󰌾";
                                    label: "Lock";
                                    clicked => { root.vault_lock(); }
                                }
                            }

                            if root.vault_form_visible: Rectangle {
                                vertical-stretch: 1;
                                VerticalLayout {
                                    spacing: 8px;
                                    Text {
                                        text: "Name";
                                        color: #abb2bf;
                                        font-size: 12px;
                                        font-weight: 700;
                                    }
                                    Rectangle {
                                        height: 38px;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: vault_name_input.has-focus ? #e5c07b : #3e4451;
                                        background: #181a1f;
                                        vault_name_input := TextInput {
                                            text <=> root.vault_new_name;
                                            width: 100%;
                                            height: 100%;
                                            vertical-alignment: center;
                                            font-size: 14px;
                                            color: #ffffff;
                                            single-line: true;
                                            accepted => { vault_secret_input.focus(); }
                                        }
                                    }
                                    Text {
                                        text: "Secret";
                                        color: #abb2bf;
                                        font-size: 12px;
                                        font-weight: 700;
                                    }
                                    Rectangle {
                                        height: 38px;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: vault_secret_input.has-focus ? #e5c07b : #3e4451;
                                        background: #181a1f;
                                        vault_secret_input := TextInput {
                                            text <=> root.vault_new_secret;
                                            width: 100%;
                                            height: 100%;
                                            vertical-alignment: center;
                                            font-size: 14px;
                                            color: #ffffff;
                                            single-line: true;
                                            accepted => { vault_note_input.focus(); }
                                        }
                                    }
                                    Text {
                                        text: "Note (Optional)";
                                        color: #abb2bf;
                                        font-size: 12px;
                                        font-weight: 700;
                                    }
                                    Rectangle {
                                        height: 38px;
                                        border-radius: 8px;
                                        border-width: 1px;
                                        border-color: vault_note_input.has-focus ? #e5c07b : #3e4451;
                                        background: #181a1f;
                                        vault_note_input := TextInput {
                                            text <=> root.vault_new_note;
                                            width: 100%;
                                            height: 100%;
                                            vertical-alignment: center;
                                            font-size: 14px;
                                            color: #ffffff;
                                            single-line: true;
                                        }
                                    }
                                    Rectangle { vertical-stretch: 1; }
                                    HorizontalLayout {
                                        spacing: 10px;
                                        QuickActionButton {
                                            horizontal-stretch: 1;
                                            icon: "✕";
                                            label: "Cancel";
                                            clicked => { root.vault_form_visible = false; }
                                        }
                                        QuickActionButton {
                                            horizontal-stretch: 1;
                                            icon: "+";
                                            label: "Save";
                                            clicked => {
                                                root.vault_add(root.vault_new_name, root.vault_new_secret, root.vault_new_note);
                                                root.vault_form_visible = false;
                                            }
                                        }
                                    }
                                }
                            }

                            if !root.vault_form_visible: Rectangle {
                                vertical-stretch: 1;
                                if root.vault_items.length == 0: Text {
                                    text: "Vault is empty\nUse + to add an API key or secret.";
                                    color: #5c6370;
                                    font-size: 14px;
                                    horizontal-alignment: center;
                                    vertical-alignment: center;
                                    width: 100%;
                                    height: 100%;
                                }
                                if root.vault_items.length > 0: Flickable {
                                    width: 100%;
                                    height: 100%;
                                    viewport-height: vault_list.preferred-height;
                                    vault_list := VerticalLayout {
                                        width: parent.width;
                                        alignment: start;
                                        spacing: 7px;
                                        for item in root.vault_items: Rectangle {
                                            height: 48px;
                                            border-radius: 12px;
                                            border-width: 1px;
                                            border-color: #3e4451;
                                            background: vault_row_ta.has-hover ? #2c323c : #252931;

                                            vault_row_ta := TouchArea {
                                                width: 100%;
                                                height: 100%;
                                                mouse-cursor: pointer;
                                            }

                                            HorizontalLayout {
                                                padding-left: 14px;
                                                padding-right: 10px;
                                                spacing: 10px;
                                                Text {
                                                    text: "󰌋";
                                                    color: #e5c07b;
                                                    font-family: "JetBrainsMono Nerd Font Propo";
                                                    font-size: 20px;
                                                    width: 24px;
                                                    vertical-alignment: center;
                                                    horizontal-alignment: center;
                                                }
                                                VerticalLayout {
                                                    alignment: center;
                                                    spacing: 1px;
                                                    Text {
                                                        text: item.name;
                                                        color: #ffffff;
                                                        font-size: 13px;
                                                        font-weight: 700;
                                                        overflow: elide;
                                                    }
                                                    Text {
                                                        text: item.note;
                                                        color: #5c6370;
                                                        font-size: 10px;
                                                        overflow: elide;
                                                    }
                                                }
                                                Rectangle { horizontal-stretch: 1; }
                                                Rectangle {
                                                    width: 26px;
                                                    height: 26px;
                                                    border-radius: 13px;
                                                    background: delete_vault_ta.has-hover ? #4b2a2e : transparent;
                                                    Text {
                                                        text: "✕";
                                                        color: #e06c75;
                                                        font-size: 12px;
                                                        width: 100%;
                                                        height: 100%;
                                                        horizontal-alignment: center;
                                                        vertical-alignment: center;
                                                    }
                                                    delete_vault_ta := TouchArea {
                                                        width: 100%;
                                                        height: 100%;
                                                        mouse-cursor: pointer;
                                                        clicked => { root.vault_delete(item.id); }
                                                    }
                                                }
                                            }
                                        }
                                    }
                                }
                            }
                        }
                    }

                    // ====== FUTURE INLINE VIEWS ======
                    UtilityPlaceholder {
                        visible: root.current_view != "main" && root.current_view != "power" && root.current_view != "folders" && root.current_view != "calendar" && root.current_view != "notes" && root.current_view != "vault";
                        width: 100%;
                        height: 100%;
                        icon: root.current_view == "calendar" ? "󰃭" :
                            root.current_view == "notes" ? "󰎚" :
                            root.current_view == "folders" ? "󰉋" : "󰈞";
                        title: root.current_view == "calendar" ? "Clock & Calendar" :
                            root.current_view == "notes" ? "Notes" :
                            "Folders";
                        description: root.current_view == "calendar" ? "A simple clock and calendar are planned for a later phase." :
                            root.current_view == "notes" ? "Named local notes are planned for a later phase." :
                            "Pinned Yazi folders are planned for a later phase.";
                    }

                    // ====== POWER VIEW ======
                    GridLayout {
                        visible: root.current_view == "power";
                        padding: 24px;
                        spacing: 24px;
                        vertical-stretch: 1;
                        Row {
                            PowerButton {
                                icon: "󰌾";
                                label: "Lock";
                                icon_color: #e5c07b;
                                bg: #3e4451;
                                is_focused: root.power_index == 0;
                                clicked => { root.power_action("lock"); }
                            }
                            PowerButton {
                                icon: "󰐥";
                                label: "Shutdown";
                                icon_color: #e06c75;
                                bg: #4b2a2e;
                                is_focused: root.power_index == 1;
                                clicked => { root.power_action("shutdown"); }
                            }
                        }
                        Row {
                            PowerButton {
                                icon: "󰍃";
                                label: "Logout";
                                icon_color: #56b6c2;
                                bg: #2c323c;
                                is_focused: root.power_index == 2;
                                clicked => { root.power_action("logout"); }
                            }
                            PowerButton {
                                icon: "󰜉";
                                label: "Reboot";
                                icon_color: #98c379;
                                bg: #3e4451;
                                is_focused: root.power_index == 3;
                                clicked => { root.power_action("reboot"); }
                            }
                        }
                    }
                }
            }

            toast := Rectangle {
                visible: root.toast_message != "";
                width: 300px;
                height: 34px;
                x: (parent.width - self.width) / 2;
                y: parent.height - self.height - 16px;
                border-radius: 17px;
                border-width: 1px;
                border-color: #3e4451;
                background: #2c323c;

                Text {
                    text: root.toast_message;
                    color: #ffffff;
                    font-size: 12px;
                    font-weight: 600;
                    width: 100%;
                    height: 100%;
                    horizontal-alignment: center;
                    vertical-alignment: center;
                    overflow: elide;
                }
            }
        }

        toast_timer := Timer {
            interval: 1800ms;
            running: root.toast_message != "";
            triggered => { root.toast_message = ""; }
        }

        note_save_timer := Timer {
            interval: 750ms;
            running: root.note_dirty;
            triggered => {
                root.note_dirty = false;
                if (root.selected_note_id != "") {
                    root.save_note(root.selected_note_id, root.note_title, root.note_content);
                }
            }
        }
    }
}
