[Unit]
Description=Unified Launcher Daemon
Documentation=https://github.com/alankarter1275/unified-launcher
After=graphical-session.target
BindsTo=graphical-session.target

[Service]
Type=simple
ExecStart=%h/.cargo/bin/daemon
Restart=on-failure
RestartSec=1

[Install]
WantedBy=graphical-session.target
